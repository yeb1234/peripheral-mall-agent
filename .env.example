# ============ 复制为 .env 后按需修改 ============
# 本地快速体验（零依赖）可全部保持默认：
#   DATABASE_URL 用 sqlite，CACHE_BACKEND 用 memory，LLM_BACKEND 用 mock
# 跑通后再逐步切到 Postgres / Redis / 真实大模型。

APP_NAME=P4 外设商城 · 企业级 Agent Demo
ENV=dev

# 数据库：本地 sqlite（aiosqlite）| 生产 postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./p4agent.db

# 缓存/锁：memory（单机零依赖）| redis
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# 大模型：mock（无密钥可跑通全套编排）| openai（兼容 vLLM/任何 OpenAI 协议）
# 当前外部端点示例：TokenPlan / DeepSeek V4.1 Flash 1017（运行时以 backend/llm_config.json 为准）
LLM_BACKEND=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
OPENAI_MODEL=deepseek-v4.1-flash-1017

# 第一层语义理解（改写 + 意图识别 + 槽位 + 多意图拆解）
# auto：直白业务句走规则短路，只有指代/多意图/模糊表述才调 LLM（推荐）
# always：每轮都由 LLM 理解（演示用，成本更高）；off：纯规则（断网/压测/额度耗尽）
NLU_MODE=auto
NLU_MAX_SUB_INTENTS=3

# LLM 限流：全局串行锁 + 最小间隔 + 429 指数退避（低额度端点建议保留）
LLM_MIN_INTERVAL=1.5
LLM_MAX_RETRIES=5
LLM_RETRY_MAX=8.0
LLM_QUEUE_TIMEOUT=30.0

# 硅基流动 SiliconFlow：RAG 商品知识库检索链路（reranker / embedding）
# 不填也能跑：rerank 会自动降级为关键词召回顺序，客服对话不会中断。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3

# 阿里云百炼 EnhancedSearch MCP + Tavily：客服联网检索（多源）
# 百炼吃中文/国内语境，Tavily 吃英文/海外源；auto 按语种选主源，结果不足自动补次源。
# 不填也能跑：检索失败自动降级为本地商品资料答复，客服对话不会中断。
WEBSEARCH_ENABLED=true
WEBSEARCH_API_KEY=
WEBSEARCH_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/EnhancedSearch/mcp
WEBSEARCH_TOOL=search_pro
WEBSEARCH_TIMEOUT=15
WEBSEARCH_MAX_RESULTS=5
WEBSEARCH_CACHE_TTL=600

# 多源路由：auto（中文→百炼，英文→Tavily）| bailian | tavily | both
WEBSEARCH_SOURCE=auto
WEBSEARCH_FALLBACK=true
WEBSEARCH_MIN_RESULTS=3
WEBSEARCH_RERANK=true

# Tavily：英文 / 海外源
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TOPIC=general
TAVILY_TIMEOUT=15
TAVILY_MAX_RETRIES=2

# 安全参数（一般无需改）
SESSION_TTL_SECONDS=1800
WRITE_RATE_LIMIT=2
WRITE_RATE_WINDOW=600
IDEMPOTENCY_TTL=86400
MAX_BOUND_ORDERS=3
ORDER_BIND_WINDOW_DAYS=90
CONFIRM_TTL_SECONDS=300

# Web
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# ============ 存储：Postgres + pgvector ============
# 只有 DATABASE_URL 指向 postgresql 时向量层才启用；SQLite 下整层跳过，服务照常起。
PGVECTOR_ENABLED=true
PGVECTOR_DIM=1024                 # bge-m3 输出维度，换 embedding 模型必须同步改并重建表
STORAGE_DIR=./storage             # 文档/驱动落盘目录；compose 内是 /data/storage

# ============ P6 联动（VidFlow 商品视频管线）============
# P4 出商品卡、P6 出文案；两条通道：REST /api/copy/generate 与 MCP /mcp。
P6_BASE_URL=http://127.0.0.1:12706
P6_TIMEOUT=8
P6_COPY_ENABLED=true

# ============ P3 第一信源（参数/跑分/评测事实库）============
# 严格对比先查 P3，未覆盖才走商品库/公开网络（第二信源）。
# 宿主调试 127.0.0.1:12415；同 compose 网络用 http://p3v2-mcp:8000/mcp。
P3_MCP_ENABLED=true
P3_MCP_URL=http://127.0.0.1:12415/mcp
P3_MCP_TIMEOUT=30
# 同参数结果复用秒数；P3 同秒重复请求会撞 run_traces 主键，0=关闭缓存
P3_CACHE_TTL=60


